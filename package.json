{
  "name": "crownguard",
  "version": "1.0.0",
  "description": "Crown-jewel risk assessment wizard for Microsoft 365, Google and AWS environments, with a branded PDF report. Runs entirely in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsx scripts/gen-schema.ts && vite build",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc",
    "validate:content": "tsx scripts/validate-content.ts",
    "ism:build": "tsx scripts/ism/build.ts",
    "watch:sources": "tsx scripts/watch/index.ts",
    "watch:apply": "tsx scripts/watch/apply-cli.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts"
  },
  "author": "Justin Middler",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "linkedom": "^0.18.13",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "type": "module"
}
